{"at": "2026-10-19T12:02:09.171725+00:00", "cwd": "/var/folders/bm/_th7x19x2dj9p9_79dm3g3940000gn/T/coco-push-forward-g56i2o5w/jira_write_failure/work", "argv": ["git", "diff", "8707c89f451703aa815f48aeffea80a96cf2d8bf", "af25206e7908b7f167da7e7d2e84f56a8e9a5293"], "exit": 0, "stdout": "diff --git a/src/tokens.py b/src/tokens.py\nindex 3a020db..3ab69ee 100644\n--- a/src/tokens.py\n+++ b/src/tokens.py\n@@ -1,2 +1,20 @@\n def expired(now, expires_at):\n     return now >= expires_at\n+\n+class TokenFamily:\n+    def __init__(self):\n+        self.current = \"token-0\"\n+        self.used = set()\n+        self.revoked = False\n+        self.sequence = 0\n+\n+    def rotate(self, supplied):\n+        if supplied in self.used:\n+            self.revoked = True\n+            raise ValueError(\"reused token\")\n+        if self.revoked or supplied != self.current:\n+            raise ValueError(\"invalid token\")\n+        self.used.add(supplied)\n+        self.sequence += 1\n+        self.current = f\"token-{self.sequence}\"\n+        return self.current\ndiff --git a/tests/test_tokens.py b/tests/test_tokens.py\nnew file mode 100644\nindex 0000000..2e634ac\n--- /dev/null\n+++ b/tests/test_tokens.py\n@@ -0,0 +1,19 @@\n+import unittest\n+from src.tokens import expired, TokenFamily\n+\n+class TokenBehavior(unittest.TestCase):\n+    def test_expiry_boundary(self):\n+        self.assertFalse(expired(9, 10))\n+        self.assertTrue(expired(10, 10))\n+    def test_rotation_returns_fresh_token(self):\n+        family = TokenFamily()\n+        next_token = family.rotate(\"token-0\")\n+        self.assertNotEqual(next_token, \"token-0\")\n+        self.assertNotEqual(family.rotate(next_token), next_token)\n+    def test_reuse_revokes_family(self):\n+        family = TokenFamily()\n+        next_token = family.rotate(\"token-0\")\n+        with self.assertRaisesRegex(ValueError, \"reused\"):\n+            family.rotate(\"token-0\")\n+        with self.assertRaisesRegex(ValueError, \"invalid\"):\n+            family.rotate(next_token)\n", "stderr": ""}
