{"at": "2026-10-19T12:01:55.992858+00:00", "cwd": "/var/folders/bm/_th7x19x2dj9p9_79dm3g3940000gn/T/coco-push-forward-g56i2o5w/adequate_summary/work", "argv": ["git", "diff", "a9bddd3dce40b5bc9160a76f41221309365f2785", "d11198cad3db78bf97d2a999a75f0514862b0377"], "exit": 0, "stdout": "diff --git a/README.md b/README.md\nindex c340b61..fd6547b 100644\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-Local isolated token/export fixture.\n+CSV export preserves Korean text, commas, quotes, and embedded newlines.\ndiff --git a/src/exporter.py b/src/exporter.py\nnew file mode 100644\nindex 0000000..1e26683\n--- /dev/null\n+++ b/src/exporter.py\n@@ -0,0 +1,9 @@\n+import csv\n+import io\n+\n+def export_csv(rows):\n+    output = io.StringIO(newline=\"\")\n+    writer = csv.writer(output)\n+    writer.writerow([\"name\", \"note\"])\n+    writer.writerows(rows)\n+    return output.getvalue()\ndiff --git a/tests/test_export.py b/tests/test_export.py\nnew file mode 100644\nindex 0000000..4754e9e\n--- /dev/null\n+++ b/tests/test_export.py\n@@ -0,0 +1,11 @@\n+import csv\n+import io\n+import unittest\n+from src.exporter import export_csv\n+\n+class ExportBehavior(unittest.TestCase):\n+    def test_quoted_unicode_round_trip(self):\n+        rows = [[\"홍길동\", 'hello, \"world\"'], [\"Ada\", \"line1\\nline2\"]]\n+        self.assertEqual(list(csv.reader(io.StringIO(export_csv(rows)))), [[\"name\", \"note\"], *rows])\n+    def test_empty_output_still_has_header(self):\n+        self.assertEqual(list(csv.reader(io.StringIO(export_csv([])))), [[\"name\", \"note\"]])\n", "stderr": ""}
